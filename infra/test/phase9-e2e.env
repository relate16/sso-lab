# Non-secret Phase 9 browser E2E configuration. Secret material is generated
# into a mode-600 temporary env file by scripts/test/run-phase9-e2e.sh.
COMPOSE_PROJECT_NAME=sso-lab-phase9-e2e
SPRING_PROFILES_ACTIVE=test
PUBLIC_NETWORK_SUBNET=172.30.90.0/24
CADDY_IPV4_ADDRESS=172.30.90.254
TRUSTED_PROXY_CIDR=172.30.90.254/32
SERVER_FORWARD_HEADERS_STRATEGY=native
POSTGRES_DB=sso_lab_e2e
POSTGRES_USER=sso_lab_e2e
AUTH_DB_URL=jdbc:postgresql://postgres:5432/sso_lab_e2e
AUTH_HOSTNAME=auth.sso-lab.test
ADMIN_HOSTNAME=admin.sso-lab.test
HR_HOSTNAME=hr.sso-lab.test
APPROVAL_HOSTNAME=approval.sso-lab.test
AUTH_PUBLIC_URL=https://auth.sso-lab.test
ADMIN_PUBLIC_URL=https://admin.sso-lab.test
HR_PUBLIC_URL=https://hr.sso-lab.test
APPROVAL_PUBLIC_URL=https://approval.sso-lab.test
HR_REDIRECT_URI=https://hr.sso-lab.test/login/oauth2/code/hr-client
HR_POST_LOGOUT_REDIRECT_URI=https://hr.sso-lab.test/
APPROVAL_REDIRECT_URI=https://approval.sso-lab.test/login/oauth2/code/approval-client
APPROVAL_POST_LOGOUT_REDIRECT_URI=https://approval.sso-lab.test/
ADMIN_REDIRECT_URI=https://admin.sso-lab.test/login/oauth2/code/admin-client
ADMIN_POST_LOGOUT_REDIRECT_URI=https://admin.sso-lab.test/
SESSION_COOKIE_SECURE=true
TURNSTILE_ENABLED=false
GMAIL_SMTP_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=phase9-admin@example.test
