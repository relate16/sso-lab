# Local Vite and loopback-only Backend ports. Copy this file to
# .env.frontend.local before starting the local development environment.
# The copied file is intentionally ignored by Git.

SSO_LOCAL_AUTH_SERVER_PORT=18080
SSO_LOCAL_ADMIN_SERVER_PORT=18081
SSO_LOCAL_HR_SERVER_PORT=18082
SSO_LOCAL_APPROVAL_SERVER_PORT=18083

SSO_LOCAL_AUTH_SERVER_URL=http://127.0.0.1:${SSO_LOCAL_AUTH_SERVER_PORT}
SSO_LOCAL_ADMIN_SERVER_URL=http://127.0.0.1:${SSO_LOCAL_ADMIN_SERVER_PORT}
SSO_LOCAL_HR_SERVER_URL=http://127.0.0.1:${SSO_LOCAL_HR_SERVER_PORT}
SSO_LOCAL_APPROVAL_SERVER_URL=http://127.0.0.1:${SSO_LOCAL_APPROVAL_SERVER_PORT}

SSO_LOCAL_AUTH_WEB_PORT=5173
SSO_LOCAL_ADMIN_WEB_PORT=5174
SSO_LOCAL_HR_WEB_PORT=5175
SSO_LOCAL_APPROVAL_WEB_PORT=5176
