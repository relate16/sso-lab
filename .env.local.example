# Local/base Compose template. Copy this file to the Git-ignored root .env.
#
# Use this file only for local development with docker-compose.local.yml.
# Production servers use .env.example as the key contract;
# docker-compose.prod.yml replaces inline development secrets with file-backed
# Docker Secrets.
COMPOSE_PROJECT_NAME=sso-lab

# PostgreSQL: replace every CHANGE_ME value in the real, Git-ignored .env file.
POSTGRES_DB=sso_lab
POSTGRES_USER=sso_lab
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
AUTH_DB_URL=jdbc:postgresql://postgres:5432/sso_lab
GALLERY_DB_URL=jdbc:postgresql://postgres:5432/sso_lab

# Local runtime policy. docker-compose.local.yml further narrows each service.
SPRING_PROFILES_ACTIVE=test
SESSION_COOKIE_SECURE=false

# Loopback origins used by the local Vite/BFF flow.
AUTH_PUBLIC_URL=http://127.0.0.1:5173

# Phase 4 OIDC issuer/signing. Generate an RSA key pair outside the repository.
# Store PKCS#8 private key DER and X.509 public key DER as Base64 in the real
# ignored environment (or Docker Secret). Never commit real key material.
AUTH_LOGIN_PAGE_URI=/?login=required
JWT_SIGNING_KEY_ID=sso-lab-signing-v1
JWT_SIGNING_KEY_PROVIDER=ENVIRONMENT
JWT_PRIVATE_KEY_REF=SSO_JWT_PRIVATE_KEY
JWT_PUBLIC_KEY_REF=SSO_JWT_PUBLIC_KEY
SSO_JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8_RSA_PRIVATE_KEY_DER
SSO_JWT_PUBLIC_KEY=CHANGE_ME_BASE64_X509_RSA_PUBLIC_KEY_DER

# Four independent confidential BFF clients. The ENVIRONMENT provider and
# inline CHANGE_ME values below are development/base-Compose placeholders only.
# Production uses file-backed Docker Secrets and does not copy these keys into
# the server .env. Redirect URIs are exact allow-list entries.
HR_CLIENT_ID=hr-client
HR_CLIENT_SECRET_PROVIDER=ENVIRONMENT
HR_CLIENT_SECRET_REF=HR_CLIENT_SECRET
HR_CLIENT_SECRET=CHANGE_ME_UNIQUE_HR_CLIENT_SECRET
HR_CLIENT_SECRET_FILE=
HR_REDIRECT_URI=http://127.0.0.1:5175/login/oauth2/code/hr-client
HR_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5175/

APPROVAL_CLIENT_ID=approval-client
APPROVAL_CLIENT_SECRET_PROVIDER=ENVIRONMENT
APPROVAL_CLIENT_SECRET_REF=APPROVAL_CLIENT_SECRET
APPROVAL_CLIENT_SECRET=CHANGE_ME_UNIQUE_APPROVAL_CLIENT_SECRET
APPROVAL_CLIENT_SECRET_FILE=
APPROVAL_REDIRECT_URI=http://127.0.0.1:5176/login/oauth2/code/approval-client
APPROVAL_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5176/

ADMIN_CLIENT_ID=admin-client
ADMIN_CLIENT_SECRET_PROVIDER=ENVIRONMENT
ADMIN_CLIENT_SECRET_REF=ADMIN_CLIENT_SECRET
ADMIN_CLIENT_SECRET=CHANGE_ME_UNIQUE_ADMIN_CLIENT_SECRET
ADMIN_CLIENT_SECRET_FILE=
ADMIN_REDIRECT_URI=http://127.0.0.1:5174/login/oauth2/code/admin-client
ADMIN_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5174/

GALLERY_CLIENT_ID=gallery-client
GALLERY_CLIENT_SECRET_PROVIDER=ENVIRONMENT
GALLERY_CLIENT_SECRET_REF=GALLERY_CLIENT_SECRET
GALLERY_CLIENT_SECRET=CHANGE_ME_UNIQUE_GALLERY_CLIENT_SECRET
GALLERY_CLIENT_SECRET_FILE=
GALLERY_REDIRECT_URI=http://127.0.0.1:5177/login/oauth2/code/gallery-client
GALLERY_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5177/

# Phase 5 Admin Server -> Auth Server internal service authentication. This
# credential must be independent from the OIDC client secret.
ADMIN_INTERNAL_CLIENT_ID=admin-server
ADMIN_INTERNAL_SECRET_PROVIDER=ENVIRONMENT
ADMIN_INTERNAL_SECRET_REF=ADMIN_INTERNAL_API_SECRET
ADMIN_INTERNAL_API_SECRET=CHANGE_ME_UNIQUE_INTERNAL_SERVICE_SECRET
ADMIN_INTERNAL_API_SECRET_FILE=

# Turnstile and SMTP stay disabled in local Compose by default.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_PROVIDER=ENVIRONMENT
TURNSTILE_SECRET_REF=TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=CHANGE_ME_CLOUDFLARE_TURNSTILE_SECRET
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid

# Optional local mail transport. Leave disabled unless explicitly testing SMTP.
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_FROM=
GMAIL_PASSWORD_PROVIDER=ENVIRONMENT
GMAIL_PASSWORD_REF=GMAIL_APP_PASSWORD
GMAIL_APP_PASSWORD=

# Phase 2 identity crypto configuration. Provider/reference values are not
# secrets. The CHANGE_ME values below are deliberately unusable placeholders;
# generate independent Base64-encoded 32-byte keys in the real, ignored env or
# provide files through Docker Secret. Never reuse the two keys.
EMAIL_ENCRYPTION_KEY_PROVIDER=ENVIRONMENT
EMAIL_ENCRYPTION_KEY_REF=SSO_EMAIL_ENCRYPTION_KEY
EMAIL_ENCRYPTION_KEY_VERSION=1
SSO_EMAIL_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_AES_KEY

EMAIL_LOOKUP_HMAC_KEY_PROVIDER=ENVIRONMENT
EMAIL_LOOKUP_HMAC_KEY_REF=SSO_EMAIL_LOOKUP_HMAC_KEY
SSO_EMAIL_LOOKUP_HMAC_KEY=CHANGE_ME_BASE64_ENCODED_INDEPENDENT_HMAC_KEY

# Phase 3 passwordless verifier/TOTP keys. Generate two additional independent
# Base64-encoded 32-byte keys. OTP values are HMACed and TOTP secrets are
# AES-256-GCM encrypted; neither value is stored in plaintext.
OTP_HMAC_KEY_PROVIDER=ENVIRONMENT
OTP_HMAC_KEY_REF=SSO_OTP_HMAC_KEY
SSO_OTP_HMAC_KEY=CHANGE_ME_BASE64_ENCODED_INDEPENDENT_OTP_HMAC_KEY

TOTP_ENCRYPTION_KEY_PROVIDER=ENVIRONMENT
TOTP_ENCRYPTION_KEY_REF=SSO_TOTP_ENCRYPTION_KEY
TOTP_ENCRYPTION_KEY_VERSION=1
SSO_TOTP_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_INDEPENDENT_TOTP_AES_KEY

# Never put real values for encryption, HMAC, JWT, SMTP, Turnstile secret, or
# OIDC client secrets in this example file.
