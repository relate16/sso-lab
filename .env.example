# Canonical production/server .env key contract.
#
# Copy this file to /opt/sso-lab/.env and replace every example/CHANGE_ME value.
# Do not add file-backed Secret values here. Production client, crypto, SMTP,
# Turnstile, and signing secrets belong in PRODUCTION_SECRET_DIR.

COMPOSE_PROJECT_NAME=sso-lab

# Immutable release images and public TLS
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=CHANGE_ME_GITHUB_OWNER_OR_ORG
IMAGE_TAG=CHANGE_ME_IMMUTABLE_RELEASE_TAG
ACME_EMAIL=CHANGE_ME_ACME_CONTACT_EMAIL

# Public DNS hostnames. Every hostname must resolve to the deployment host.
AUTH_HOSTNAME=auth.example.invalid
ADMIN_HOSTNAME=admin.example.invalid
HR_HOSTNAME=hr.example.invalid
APPROVAL_HOSTNAME=approval.example.invalid
GALLERY_HOSTNAME=gallery.example.invalid

# File-backed Docker Secret location and container runtime identity
PRODUCTION_SECRET_DIR=./secrets
BACKEND_RUNTIME_UID=1000
BACKEND_RUNTIME_GID=1000

# Caddy is the only trusted public edge
PUBLIC_NETWORK_SUBNET=172.30.10.0/24
CADDY_IPV4_ADDRESS=172.30.10.254
TRUSTED_PROXY_CIDR=172.30.10.254/32
SERVER_FORWARD_HEADERS_STRATEGY=native

# PostgreSQL. POSTGRES_PASSWORD is the only current production credential kept
# in .env; all other credentials are file-backed Docker Secrets.
POSTGRES_DB=sso_lab
POSTGRES_USER=sso_lab
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
AUTH_DB_URL=jdbc:postgresql://postgres:5432/sso_lab
GALLERY_DB_URL=jdbc:postgresql://postgres:5432/sso_lab

# Runtime policy
SPRING_PROFILES_ACTIVE=prod
SESSION_COOKIE_SECURE=true
AUTH_LOGIN_PAGE_URI=/?login=required
JWT_SIGNING_KEY_ID=sso-lab-signing-v1
EMAIL_ENCRYPTION_KEY_VERSION=1
TOTP_ENCRYPTION_KEY_VERSION=1

# Public origins. AUTH_PUBLIC_URL is the OIDC issuer. The three legacy service
# URL keys remain part of the current production audit contract; Gallery uses
# GALLERY_HOSTNAME plus its exact redirect/logout URIs and has no public-URL key.
AUTH_PUBLIC_URL=https://auth.example.invalid
ADMIN_PUBLIC_URL=https://admin.example.invalid
HR_PUBLIC_URL=https://hr.example.invalid
APPROVAL_PUBLIC_URL=https://approval.example.invalid

# Exact OIDC client configuration. Wildcards are not allowed.
HR_CLIENT_ID=hr-client
HR_REDIRECT_URI=https://hr.example.invalid/login/oauth2/code/hr-client
HR_POST_LOGOUT_REDIRECT_URI=https://hr.example.invalid/

APPROVAL_CLIENT_ID=approval-client
APPROVAL_REDIRECT_URI=https://approval.example.invalid/login/oauth2/code/approval-client
APPROVAL_POST_LOGOUT_REDIRECT_URI=https://approval.example.invalid/

ADMIN_CLIENT_ID=admin-client
ADMIN_REDIRECT_URI=https://admin.example.invalid/login/oauth2/code/admin-client
ADMIN_POST_LOGOUT_REDIRECT_URI=https://admin.example.invalid/

GALLERY_CLIENT_ID=gallery-client
GALLERY_REDIRECT_URI=https://gallery.example.invalid/login/oauth2/code/gallery-client
GALLERY_POST_LOGOUT_REDIRECT_URI=https://gallery.example.invalid/

# Non-secret service configuration
ADMIN_INTERNAL_CLIENT_ID=admin-server
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=CHANGE_ME_PUBLIC_SITE_KEY
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=CHANGE_ME_GMAIL_ACCOUNT
GMAIL_SMTP_FROM=CHANGE_ME_VERIFIED_FROM_ADDRESS
