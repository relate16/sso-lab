# Local Backend configuration for the remote-shared database mode.
# Copy to .env.backend.local (Git ignored), replace every CHANGE_ME value,
# and never copy Production secret files into the repository.

COMPOSE_PROJECT_NAME=sso-lab-local

# Compose still renders the base postgres service, but the shared-db override
# does not start it. These values also configure auth-server's shared DB login.
POSTGRES_DB=CHANGE_ME_SHARED_DB
POSTGRES_USER=CHANGE_ME_SHARED_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_SHARED_DB_PASSWORD
SSO_LOCAL_SHARED_AUTH_DB_URL=jdbc:postgresql://host.docker.internal:15432/sso_lab
SSO_LOCAL_SHARED_DB_ACKNOWLEDGED=true

# Local-only OIDC clients. Keep these IDs distinct from Production clients.
SSO_LOCAL_HR_CLIENT_ID=sso-local-hr-client
SSO_LOCAL_APPROVAL_CLIENT_ID=sso-local-approval-client
SSO_LOCAL_ADMIN_CLIENT_ID=sso-local-admin-client
HR_CLIENT_SECRET=CHANGE_ME_LOCAL_HR_CLIENT_SECRET
APPROVAL_CLIENT_SECRET=CHANGE_ME_LOCAL_APPROVAL_CLIENT_SECRET
ADMIN_CLIENT_SECRET=CHANGE_ME_LOCAL_ADMIN_CLIENT_SECRET
ADMIN_INTERNAL_API_SECRET=CHANGE_ME_LOCAL_INTERNAL_API_SECRET

# Local-only cryptographic material. Use independent random values; do not copy
# Production keys. AES/HMAC values are Base64, and RSA values use the formats
# documented in docs/SECRET_MANAGEMENT.md.
SSO_EMAIL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_AES_KEY
SSO_EMAIL_LOOKUP_HMAC_KEY=CHANGE_ME_BASE64_LOCAL_HMAC_KEY
SSO_OTP_HMAC_KEY=CHANGE_ME_BASE64_LOCAL_OTP_HMAC_KEY
SSO_TOTP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_TOTP_AES_KEY
SSO_JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8_LOCAL_RSA_PRIVATE_KEY_DER
SSO_JWT_PUBLIC_KEY=CHANGE_ME_BASE64_X509_LOCAL_RSA_PUBLIC_KEY_DER
