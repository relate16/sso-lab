# Local Backend configuration for the remote-shared database mode.
# Copy to .env.backend.local (Git ignored), replace every CHANGE_ME value,
# and never copy Production secret files into the repository.

COMPOSE_PROJECT_NAME=sso-lab-local

# Compose still renders the base postgres service, but the shared-db override
# does not start it. These values also configure auth-server's shared DB login.
POSTGRES_DB=CHANGE_ME_SHARED_DB
POSTGRES_USER=CHANGE_ME_SHARED_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_SHARED_DB_PASSWORD
SSO_LOCAL_SHARED_AUTH_DB_URL=jdbc:postgresql://host.docker.internal:15432/sso_lab
# Windows JVM/IntelliJ connects to the same SSH tunnel through loopback.
AUTH_DB_URL=jdbc:postgresql://127.0.0.1:15432/sso_lab
SSO_LOCAL_SHARED_DB_ACKNOWLEDGED=true

# Shared database safety controls. These values are required for both the
# PowerShell JAR launcher and IntelliJ Application run configurations.
SPRING_FLYWAY_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false
TURNSTILE_ENABLED=false
SSO_TEST_SUPPORT_ENABLED=false
SESSION_COOKIE_SECURE=false
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Keep false for startup/health-only checks. Set true only when deliberately
# sending a real login OTP with separately approved SMTP credentials.
SSO_LOCAL_SHARED_GMAIL_ENABLED=false
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
GMAIL_SMTP_FROM=CHANGE_ME_SMTP_FROM
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD

# Local-only OIDC clients. Keep these IDs distinct from Production clients.
SSO_LOCAL_HR_CLIENT_ID=sso-local-hr-client
SSO_LOCAL_APPROVAL_CLIENT_ID=sso-local-approval-client
SSO_LOCAL_ADMIN_CLIENT_ID=sso-local-admin-client
HR_CLIENT_ID=sso-local-hr-client
APPROVAL_CLIENT_ID=sso-local-approval-client
ADMIN_CLIENT_ID=sso-local-admin-client
HR_CLIENT_SECRET=CHANGE_ME_LOCAL_HR_CLIENT_SECRET
APPROVAL_CLIENT_SECRET=CHANGE_ME_LOCAL_APPROVAL_CLIENT_SECRET
ADMIN_CLIENT_SECRET=CHANGE_ME_LOCAL_ADMIN_CLIENT_SECRET
ADMIN_INTERNAL_API_SECRET=CHANGE_ME_LOCAL_INTERNAL_API_SECRET

# Local-only cryptographic material. Use independent random values; do not copy
# Production keys. AES/HMAC values are Base64, and RSA values use the formats
# documented in docs/SECRET_MANAGEMENT.md.
SSO_EMAIL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_AES_KEY
SSO_EMAIL_LOOKUP_HMAC_KEY=CHANGE_ME_BASE64_LOCAL_HMAC_KEY
SSO_OTP_HMAC_KEY=CHANGE_ME_BASE64_LOCAL_OTP_HMAC_KEY
SSO_TOTP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_TOTP_AES_KEY
SSO_JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8_LOCAL_RSA_PRIVATE_KEY_DER
SSO_JWT_PUBLIC_KEY=CHANGE_ME_BASE64_X509_LOCAL_RSA_PUBLIC_KEY_DER

# Local issuer, callbacks, logout targets, and internal service endpoints.
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_INTERNAL_URL=http://127.0.0.1:18080
HR_REGISTRATION_ID=hr-client
APPROVAL_REGISTRATION_ID=approval-client
ADMIN_REGISTRATION_ID=admin-client
HR_REDIRECT_URI=http://127.0.0.1:5175/login/oauth2/code/hr-client
HR_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5175/
HR_BACKCHANNEL_LOGOUT_URI=http://127.0.0.1:18082/internal/oidc/backchannel-logout
APPROVAL_REDIRECT_URI=http://127.0.0.1:5176/login/oauth2/code/approval-client
APPROVAL_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5176/
APPROVAL_BACKCHANNEL_LOGOUT_URI=http://127.0.0.1:18083/internal/oidc/backchannel-logout
ADMIN_REDIRECT_URI=http://127.0.0.1:5174/login/oauth2/code/admin-client
ADMIN_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5174/
ADMIN_BACKCHANNEL_LOGOUT_URI=http://127.0.0.1:18081/internal/oidc/backchannel-logout
ADMIN_INTERNAL_URL=http://127.0.0.1:18080/internal/admin/v1
